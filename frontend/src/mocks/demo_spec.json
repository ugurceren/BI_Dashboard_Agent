      "options": {
        "format": "compact",
        "showLegend": true,
        "smooth": true
      },
      "position": {
        "x": 0,
        "y": 2,
        "w": 8,
        "h": 4
      }
    },
    {
      "id": "region_bar",
      "type": "bar",
      "title": "Bölge Bazında Satış",
      "datasetId": "region_sales",
      "encoding": {
        "x": "region",
        "y": [
          "sales_amount"
        ]
      },
      "options": {
        "horizontal": true,
        "sort": "desc",
        "format": "compact",
        "showLabels": true
      },
      "position": {
        "x": 8,
        "y": 2,
        "w": 4,
        "h": 4
      }
    },
    {
      "id": "category_donut",
      "type": "donut",
      "title": "Kategori Dağılımı",
      "datasetId": "category_share",
      "encoding": {
        "category": "category_name",
        "value": "sales_amount"
      },
      "options": {
