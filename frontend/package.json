{
  "name": "bi-lens-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "build:viewer": "tsc --noEmit -p . && vite build --config vite.viewer.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p .",
    "e2e": "npm run build && node e2e/run-all.mjs",
    "e2e:llm": "npm run build && node e2e/run-llm.mjs",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report e2e/report/desktop",
    "shots": "node e2e/shots.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@dagrejs/dagre": "^3.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.16",
    "echarts": "^6.1.0",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
