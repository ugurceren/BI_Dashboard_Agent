# Bu dosyayı .env olarak kopyalayın ve kurum sunucunuza göre düzenleyin.

# ---------- Ana LLM (OpenAI uyumlu endpoint) ----------
# vLLM:   python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen3-32B --enable-auto-tool-choice --tool-call-parser hermes
# Ollama: LLM_BASE_URL=http://gpu-sunucu:11434/v1   LLM_MODEL=qwen3:32b
LLM_BASE_URL=http://gpu-sunucu:8001/v1
LLM_API_KEY=EMPTY
LLM_MODEL=Qwen/Qwen3-32B
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# auto | native | prompt   (sunucuda tool-call parser yoksa "prompt")
LLM_TOOL_MODE=auto
# Qwen3'te "thinking" kapatmak (daha hızlı yanıt) — vLLM:
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# ---------- Görsel model (örnek dashboard görseli okumak için; boşsa sadece renkler çıkarılır) ----------
# VISION_BASE_URL=http://gpu-sunucu:8002/v1
# VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# ---------- Veri kaynağı: SQL Server (salt-okunur kullanıcı önerilir) ----------
# Veri sözlüğü bağlantısı config/dictionary.toml içinde.
# DRIVER: yazan sürücü kurulu değilse kurulu olan en yeni SQL Server sürücüsü (18 → 17 …) otomatik kullanılır.
SQLSERVER_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=AdventureWorksDW2025;Trusted_Connection=yes;TrustServerCertificate=yes;

# Tutar görsellerinde para birimi belirtilmemişse (AdventureWorks verisi USD)
DEFAULT_CURRENCY=USD

# ---------- Kimlik (LDAP / Active Directory, isteğe bağlı; pip install ldap3) ----------
# Boşsa kullanıcı Windows oturumundan tanınır; etki alanındaki PC'de ad AD'den gelir.
# LDAP_URL=ldap://dc01.kurum.local
# LDAP_BASE_DN=DC=kurum,DC=local
# LDAP_BIND_USER=KURUM\svc_bi
# LDAP_BIND_PASSWORD=
# Sunucu kurulumunda IIS/nginx Windows kimlik doğrulaması arkasındaysa:
# TRUST_REMOTE_USER_HEADER=true

# ---------- Kullanıcı rolü (config/policy.toml [identity] eşlemesi yoksa) ----------
USER_ROLE=standart
